# macOS
.DS_Store
._*

# Runtime output (regenerated each run)
Logs/
Evidence/
Reports/
Audit/
*.jsonl

# Large runtime log files
GovernanceToolkit_*.json

# Vault data (encrypted credentials)
Data/*.enc

# Local config overrides (per-developer, not for commit)
Config/*.local.json

# Keep directory structure with .gitkeep
!Logs/.gitkeep
!Evidence/.gitkeep
!Reports/.gitkeep
!Data/.gitkeep
.local-backups/

# Test/dev run logs & artifacts (transient, regenerated)
docs/*.log
docs/*.log.err
docs/pester-*.xml
docs/windows-test-rounds/full-gui-validation-*/
docs/windows-test-rounds/session-*/
docs/windows-test-rounds/round-.md

# Local working notes (not repo content)
/status.md

# Transient local Pester run artifacts
Tests/_pester-*.txt
Tests/_pester-*.xml

# #Loop / orchestration journals -- kept on disk, not tracked in the product repo
docs/loop-runs/
docs/adaptive-reports-rounds/
docs/phase7-sdk-gui-rounds/
