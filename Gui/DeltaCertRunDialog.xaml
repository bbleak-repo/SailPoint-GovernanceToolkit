<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delta Cert Run Parameters"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="450"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6DACE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A85BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#1E1E2E">
        <StackPanel>
            <!-- Source IDs -->
            <TextBlock Text="Source IDs (comma-separated):" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtSourceIds" Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

            <!-- Hours Back + Deadline Days side by side -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hours Back:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtHoursBack" Style="{StaticResource FieldBox}" Width="80"
                             HorizontalAlignment="Left" Text="24"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Deadline Days:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtDeadlineDays" Style="{StaticResource FieldBox}" Width="80"
                             HorizontalAlignment="Left" Text="2"/>
                </StackPanel>
            </Grid>

            <!-- Reviewer Mode -->
            <TextBlock Text="Reviewer Mode:" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CboReviewerMode" Width="160" HorizontalAlignment="Left"
                      Background="#2D2D44" Foreground="#E0E0E0"
                      BorderBrush="#3D3D5C" BorderThickness="1"
                      FontSize="12" Margin="0,0,0,20"
                      SelectedIndex="0">
                <ComboBoxItem Content="Manager" IsSelected="True"/>
                <ComboBoxItem Content="SourceOwner"/>
            </ComboBox>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="BtnOK" Content="Run Delta Cert"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"/>
                <Button Grid.Column="3" x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
