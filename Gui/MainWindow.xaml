                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Leadership Reports:"
                                       Foreground="#5B9BD5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" FontSize="12"
                                       Margin="0,0,12,0"/>
                            <Button Grid.Column="1" x:Name="BtnDistributionPreview"
                                    Content="Preview"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,0" Padding="12,5" FontSize="11"
                                    ToolTip="Show who would receive reports without generating any files"/>
                            <Button Grid.Column="2" x:Name="BtnDistributionGenerate"
                                    Content="Generate Reports"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,0" Padding="12,5" FontSize="11"
                                    ToolTip="Generate per-leader HTML report files in the Audit output folder (no email)"/>
                            <TextBlock Grid.Column="3" x:Name="GovDistributionStatusLabel"
                                       Foreground="#AAAACC" FontSize="11" FontStyle="Italic"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       Text="Ready. Preview shows who would receive reports."/>
                            <Button Grid.Column="4" x:Name="BtnDistributionSend"
                                    Content="Generate + Send"
                                    Style="{StaticResource ToolkitButton}"
                                    Padding="12,5" FontSize="11"
                                    ToolTip="Generate reports AND email each leader their own summary (requires Audit.Smtp.Enabled = true in settings.local.json)"/>
                        </Grid>
                    </Border>

                    <!-- Row 6: Hierarchical Leadership Report -->
                    <Border Grid.Row="6" Background="#252538" CornerRadius="6"
                            BorderBrush="#3D3D5C" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title row -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Hierarchical Drill-Down Reports:"
                                           Foreground="#C77DFF" FontWeight="SemiBold"
                                           VerticalAlignment="Center" FontSize="12"
                                           Margin="0,0,12,0"
                                           ToolTip="Generate per-leader HTML reports showing the full org-tree certification rollup — VP expands to Directors, Directors to Managers, Managers to certified identities, identities to entitlement decisions."/>
                                <TextBlock Grid.Column="1"
                                           x:Name="HierStatusLabel"
                                           Foreground="#AAAACC" FontSize="11" FontStyle="Italic"
                                           VerticalAlignment="Center"
                                           Text="Ready. Each top-level leader gets one self-contained HTML file."/>
                            </Grid>

                            <!-- Controls row -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Days Back:" Foreground="#CCCCDD"
                                           FontSize="11" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtHierDaysBack"
                                         Text="30" Width="42" FontSize="11"
                                         Background="#1E1E2E" Foreground="#E0E0E0"
                                         BorderBrush="#3D3D5C" Margin="0,0,10,0"
                                         VerticalContentAlignment="Center" Padding="4,2"
                                         ToolTip="Number of calendar days to look back for campaigns (default 30)"/>

                                <TextBlock Text="Campaign Filter:" Foreground="#CCCCDD"
                                           FontSize="11" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtHierCampaignContains"
                                         Width="150" FontSize="11"
                                         Background="#1E1E2E" Foreground="#E0E0E0"
                                         BorderBrush="#3D3D5C" Margin="0,0,10,0"
                                         VerticalContentAlignment="Center" Padding="4,2"
                                         ToolTip="Optional: only include campaigns whose name contains this text (e.g. 'Daily Attestation', 'AD Delta Cert')"/>

                                <TextBlock Text="Min Level:" Foreground="#CCCCDD"
                                           FontSize="11" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <ComboBox x:Name="CboHierMinLevel"
                                          Width="130" FontSize="11"
                                          Background="#1E1E2E" Foreground="#E0E0E0"
                                          BorderBrush="#3D3D5C" Margin="0,0,10,0"
                                          ToolTip="Minimum org level to generate a top-level file for. Each leader at this level gets their own HTML file showing their full subtree.">
                                    <ComboBoxItem Content="Directors+ (level 1)" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="VPs+ (level 2)" Tag="2"/>
                                    <ComboBoxItem Content="All Certifiers (level 0)" Tag="0"/>
                                </ComboBox>

                                <Button x:Name="BtnHierPreview"
                                        Content="Preview"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,6,0" Padding="12,5" FontSize="11"
                                        ToolTip="Show which campaigns and certifications would be included — no files written"/>
                                <Button x:Name="BtnHierGenerate"
                                        Content="Generate Drill-Down Reports"
                                        Style="{StaticResource ToolkitButton}"
                                        Padding="12,5" FontSize="11"
                                        ToolTip="Generate hierarchical HTML reports — one per leader at the selected minimum level"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Row 7: Recent Governance Reports -->
                    <Grid Grid.Row="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recent Governance Reports"
                                       Foreground="#5B9BD5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="1" x:Name="BtnRefreshGovReports"
                                    Content="Refresh" Style="{StaticResource SecondaryButton}"
                                    Padding="10,4" FontSize="11"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                BorderBrush="#3D3D5C" BorderThickness="1">
                            <ListBox x:Name="GovReportList"
                                     MaxHeight="150"
                                     Background="#2D2D44"
                                     Foreground="#E0E0E0"
                                     BorderThickness="0"
                                     Margin="4"
                                     FontSize="12"/>
                        </Border>
                    </Grid>

                </Grid>
            </TabItem>

            <!-- SDK Features Tab -->
            <TabItem Header="SDK Features" Style="{StaticResource ToolkitTabItem}">
                <Grid x:Name="SdkTabContent" Background="#1E1E2E" Margin="12,8">
                    <TabControl x:Name="SdkSubTabControl" Background="#1E1E2E" BorderBrush="#3D3D5C">

                        <!-- Sub-tab 1: Templates -->
                        <TabItem Header="Templates" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnSdkRefreshTemplates" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Reload campaign templates from ISC"/>
                                    <Button x:Name="BtnSdkNewTemplate" Content="New Template"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Create a new campaign template (POST /campaign-templates)"/>
                                    <Button x:Name="BtnSdkEditSchedule" Content="Edit Schedule"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Set a recurring schedule for the selected template (MONTHLY, WEEKLY, ANNUALLY)"/>
                                    <Button x:Name="BtnSdkRemoveSchedule" Content="Remove Schedule"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Remove the schedule from the selected template"/>
                                    <Button x:Name="BtnSdkDeleteTemplate" Content="Delete"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Permanently delete the selected campaign template"/>
                                </StackPanel>

                                <!-- Templates DataGrid -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkTemplateGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn     Header="Name"      Binding="{Binding name}"             Width="*"/>
                                            <DataGridTextColumn     Header="ID"        Binding="{Binding id}"               Width="160"/>
                                            <DataGridTextColumn     Header="Deadline"  Binding="{Binding deadlineDuration}" Width="90"/>
                                            <DataGridCheckBoxColumn Header="Scheduled" Binding="{Binding scheduled}"        Width="80"/>
                                            <DataGridTextColumn     Header="Modified"  Binding="{Binding modified}"         Width="150"/>
                                            <DataGridTextColumn     Header="Owner"     Binding="{Binding ownerRef.name}"    Width="140"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Status -->
                                <TextBlock Grid.Row="2" x:Name="SdkTemplateStatusLabel"
                                           Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                           Margin="2,8,0,0"/>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 2: Cert Summaries -->
                        <TabItem Header="Cert Summaries" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Campaign:" Foreground="#AAAACC"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboSdkCertCampaign" Width="180" Margin="0,0,12,0"
                                              Background="#2D2D44" Foreground="#E0E0E0" BorderBrush="#3D3D5C"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              ToolTip="Select a campaign to view certification summaries"/>
                                    <TextBlock Text="Certification:" Foreground="#AAAACC"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboSdkCertification" Width="180" Margin="0,0,12,0"
                                              Background="#2D2D44" Foreground="#E0E0E0" BorderBrush="#3D3D5C"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              ToolTip="Select a certification reviewer to view identity summaries"/>
                                    <TextBlock Text="Access Type:" Foreground="#AAAACC"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CboSdkAccessType" Width="140" Margin="0,0,12,0"
                                              Background="#2D2D44" Foreground="#E0E0E0" BorderBrush="#3D3D5C"
                                              SelectedIndex="0"
                                              ToolTip="View: Identity summaries, or Access summaries by type (Entitlement, Role, Access Profile)">
                                        <ComboBoxItem Content="Identity"/>
                                        <ComboBoxItem Content="Entitlement"/>
                                        <ComboBoxItem Content="Role"/>
                                        <ComboBoxItem Content="Access Profile"/>
                                    </ComboBox>
                                    <Button x:Name="BtnSdkRefreshSummaries" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}"
                                            ToolTip="Reload summaries for the selected certification"/>
                                </StackPanel>

                                <!-- Cert Summary DataGrid (SDK-18 shipped: Identity + Access
                                     summaries bound to the cascade). -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkCertSummaryGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn     Header="Identity Name" Binding="{Binding identityName}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="Completed"     Binding="{Binding completed}"    Width="90"/>
                                            <DataGridTextColumn     Header="Total Items"   Binding="{Binding totalItems}"   Width="90"/>
                                            <DataGridTextColumn     Header="Approved"      Binding="{Binding approved}"     Width="90"/>
                                            <DataGridTextColumn     Header="Revoked"       Binding="{Binding revoked}"      Width="90"/>
                                            <DataGridTextColumn     Header="No Decision"   Binding="{Binding noDecision}"   Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Coming-soon overlay retired (SDK-18 shipped). Kept collapsed
                                     so the x:Name still resolves for the W-08 structural walk. -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SdkCertSummaryComingSoon"
                                               Text="Certification Summaries -- coming in a future release."
                                               Foreground="#AAAACC" FontSize="14" FontStyle="Italic"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>

                                <!-- Status + decision summary -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="SdkCertSummaryStatusLabel"
                                               Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <StackPanel Grid.Column="1" x:Name="SdkDecisionSummaryPanel"
                                                Orientation="Horizontal" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 3: Approvals -->
                        <TabItem Header="Approvals" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="RbSdkPending" Content="Pending" GroupName="SdkApprovalState"
                                                 IsChecked="True" Foreground="#E0E0E0" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" ToolTip="Show pending approvals awaiting action"/>
                                    <RadioButton x:Name="RbSdkCompleted" Content="Completed" GroupName="SdkApprovalState"
                                                 Foreground="#E0E0E0" VerticalAlignment="Center"
                                                 Margin="0,0,16,0" ToolTip="Show historical completed approvals"/>
                                    <Button x:Name="BtnSdkRefreshApprovals" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Reload approvals from ISC"/>
                                    <Button x:Name="BtnSdkApprove" Content="Approve"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Approve the selected access request"/>
                                    <Button x:Name="BtnSdkDeny" Content="Deny"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Deny the selected access request (comment required)"/>
                                    <Button x:Name="BtnSdkForward" Content="Forward"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Forward the selected approval to another reviewer"/>
                                </StackPanel>

                                <!-- Approvals DataGrid -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkApprovalGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name"          Binding="{Binding name}"           Width="*"/>
                                            <DataGridTextColumn Header="Requester"     Binding="{Binding requester}"      Width="140"/>
                                            <DataGridTextColumn Header="Requested For" Binding="{Binding requestedFor}"   Width="140"/>
                                            <DataGridTextColumn Header="Request Type"  Binding="{Binding requestType}"    Width="130"/>
                                            <DataGridTextColumn Header="Created"       Binding="{Binding created}"        Width="150"/>
                                            <DataGridTextColumn Header="Owner"         Binding="{Binding owner}"          Width="140"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Status + summary -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="SdkApprovalStatusLabel"
                                               Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <StackPanel Grid.Column="1" x:Name="SdkApprovalSummaryPanel"
                                                Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Pending / Approved / Rejected badges populated by OnLoaded -->
                                        <Border Background="#2255AA" CornerRadius="3" Padding="6,2" Margin="0,0,4,0"
                                                ToolTip="Pending approvals">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Pending: " Foreground="#E0E0E0" FontSize="11"/>
                                                <TextBlock x:Name="SdkApprovalBadgePending" Text="0"
                                                           Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#339933" CornerRadius="3" Padding="6,2" Margin="0,0,4,0"
                                                ToolTip="Approved approvals">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Approved: " Foreground="#E0E0E0" FontSize="11"/>
                                                <TextBlock x:Name="SdkApprovalBadgeApproved" Text="0"
                                                           Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#CC3333" CornerRadius="3" Padding="6,2"
                                                ToolTip="Rejected approvals">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Rejected: " Foreground="#E0E0E0" FontSize="11"/>
                                                <TextBlock x:Name="SdkApprovalBadgeRejected" Text="0"
                                                           Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 4: Work Items -->
                        <TabItem Header="Work Items" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnSdkRefreshWorkItems" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Reload work items from ISC"/>
                                    <Button x:Name="BtnSdkCompleteWorkItem" Content="Complete"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Mark the selected work item as complete"/>
                                    <Button x:Name="BtnSdkForwardWorkItem" Content="Forward"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Forward the selected work item to another reviewer"/>
                                    <Button x:Name="BtnSdkBulkApprove" Content="Bulk Approve"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,16,0"
                                            ToolTip="Approve all approval items within the selected work item"/>
                                    <CheckBox x:Name="ChkSdkShowCompleted" Content="Show Completed"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              ToolTip="Include completed work items in the list"/>
                                </StackPanel>

                                <!-- Work Items DataGrid -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkWorkItemGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type"        Binding="{Binding type}"        Width="130"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding description}" Width="*"/>
                                            <DataGridTextColumn Header="Owner"       Binding="{Binding owner}"       Width="140"/>
                                            <DataGridTextColumn Header="State"       Binding="{Binding state}"       Width="100"/>
                                            <DataGridTextColumn Header="Created"     Binding="{Binding created}"     Width="150"/>
                                            <DataGridTextColumn Header="Num Items"   Binding="{Binding numItems}"    Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Status + badges -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="SdkWorkItemStatusLabel"
                                               Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    <StackPanel Grid.Column="1" x:Name="SdkWorkItemSummaryPanel"
                                                Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="#252538" BorderBrush="#666677" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,0,8,0" MinWidth="80">
                                            <StackPanel>
                                                <TextBlock Text="Open" Foreground="#AAAACC" FontSize="10"
                                                           TextAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="SdkWiBadgeOpen" Text="-" Foreground="#5B9BD5"
                                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#252538" BorderBrush="#666677" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,0,8,0" MinWidth="80">
                                            <StackPanel>
                                                <TextBlock Text="Completed" Foreground="#AAAACC" FontSize="10"
                                                           TextAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="SdkWiBadgeCompleted" Text="-" Foreground="#5B9BD5"
                                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#252538" BorderBrush="#666677" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" MinWidth="80">
                                            <StackPanel>
                                                <TextBlock Text="Total" Foreground="#AAAACC" FontSize="10"
                                                           TextAlignment="Center" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="SdkWiBadgeTotal" Text="-" Foreground="#5B9BD5"
                                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 5: Workflows -->
                        <TabItem Header="Workflows" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnSdkRefreshWorkflows" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Reload workflows from ISC"/>
                                    <Button x:Name="BtnSdkEnableWorkflow" Content="Enable/Disable"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Toggle the enabled state of the selected workflow"/>
                                    <Button x:Name="BtnSdkTestWorkflow" Content="Test"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Test the selected workflow with sample input (workflow must be disabled)"/>
                                    <Button x:Name="BtnSdkViewExecutions" Content="Executions"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="View execution history for the selected workflow"/>
                                    <Button x:Name="BtnSdkCreateOOO" Content="Create OOO"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Create an OOO fallback reviewer workflow"/>
                                </StackPanel>

                                <!-- Workflow DataGrid -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1" Margin="0,0,0,8">
                                    <DataGrid x:Name="SdkWorkflowGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn     Header="Name"            Binding="{Binding name}"           Width="*"/>
                                            <DataGridTextColumn     Header="ID"              Binding="{Binding id}"             Width="160"/>
                                            <DataGridCheckBoxColumn Header="Enabled"         Binding="{Binding enabled}"        Width="80"/>
                                            <DataGridTextColumn     Header="Trigger Type"    Binding="{Binding triggerType}"    Width="120"/>
                                            <DataGridTextColumn     Header="Execution Count" Binding="{Binding executionCount}" Width="120"/>
                                            <DataGridTextColumn     Header="Failure Count"   Binding="{Binding failureCount}"   Width="110"/>
                                            <DataGridTextColumn     Header="Modified"        Binding="{Binding modified}"       Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Execution DataGrid -->
                                <Border Grid.Row="2" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkExecutionGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Execution ID" Binding="{Binding executionId}" Width="*"/>
                                            <DataGridTextColumn Header="Status"       Binding="{Binding status}"      Width="110"/>
                                            <DataGridTextColumn Header="Start Time"   Binding="{Binding startTime}"   Width="150"/>
                                            <DataGridTextColumn Header="Close Time"   Binding="{Binding closeTime}"   Width="150"/>
                                            <DataGridTextColumn Header="Workflow ID"  Binding="{Binding workflowId}"  Width="160"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Status -->
                                <TextBlock Grid.Row="3" x:Name="SdkWorkflowStatusLabel"
                                           Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                           Margin="2,8,0,0"/>
                            </Grid>
                        </TabItem>

                        <!-- Sub-tab 6: Filters -->
                        <TabItem Header="Filters" Style="{StaticResource ToolkitTabItem}">
                            <Grid Background="#1E1E2E" Margin="8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnSdkRefreshFilters" Content="Refresh"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                            ToolTip="Reload campaign filters from ISC"/>
                                    <Button x:Name="BtnSdkNewFilter" Content="New Filter"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Create a new campaign filter"/>
                                    <Button x:Name="BtnSdkEditFilter" Content="Edit"
                                            Style="{StaticResource ToolkitButton}" Margin="0,0,6,0"
                                            ToolTip="Edit the selected campaign filter (full replacement)"/>
                                    <Button x:Name="BtnSdkDeleteFilter" Content="Delete"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"
                                            ToolTip="Delete the selected campaign filter(s)"/>
                                    <CheckBox x:Name="ChkSdkIncludeSystem" Content="Include System"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              ToolTip="Show system-created filters alongside custom filters"/>
                                </StackPanel>

                                <!-- Filters DataGrid -->
                                <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                                        BorderBrush="#3D3D5C" BorderThickness="1">
                                    <DataGrid x:Name="SdkFilterGrid"
                                              AutoGenerateColumns="False"
                                              Background="#2D2D44"
                                              Foreground="#E0E0E0"
                                              BorderThickness="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#3D3D5C"
                                              RowBackground="#2D2D44"
                                              AlternatingRowBackground="#252538"
                                              SelectionMode="Extended"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ColumnHeaderHeight="32"
                                              RowHeight="28"
                                              Margin="2">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background"   Value="#252538"/>
                                                <Setter Property="Foreground"   Value="#5B9BD5"/>
                                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                                <Setter Property="Padding"      Value="8,4"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush"  Value="#3D3D5C"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn     Header="Name"          Binding="{Binding name}"        Width="*"/>
                                            <DataGridTextColumn     Header="ID"            Binding="{Binding id}"          Width="160"/>
                                            <DataGridTextColumn     Header="Mode"          Binding="{Binding mode}"        Width="110"/>
                                            <DataGridTextColumn     Header="Description"   Binding="{Binding description}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="System Filter" Binding="{Binding isSystem}"    Width="100"/>
                                            <DataGridTextColumn     Header="Modified"      Binding="{Binding modified}"    Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Status -->
                                <TextBlock Grid.Row="2" x:Name="SdkFilterStatusLabel"
                                           Foreground="#AAAACC" FontSize="12" FontStyle="Italic"
                                           Margin="2,8,0,0"/>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </TabItem>

            <!-- Adaptive Reports Tab -->
            <TabItem Header="Adaptive Reports" Style="{StaticResource ToolkitTabItem}">
                <Grid x:Name="AdaptiveReportsTabContent" Background="#1E1E2E" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Adaptive report form -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4">

                            <!-- Report Options: Anchor / Theme / Days Back / Status filter / Campaign name -->
                            <TextBlock Text="Report Options" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <StackPanel>
                                    <!-- Row 1: Anchor | Theme | Days Back -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Anchor -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Anchor:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="AdaptiveReportsAnchorCombo"
                                                      Style="{StaticResource FieldCombo}"
                                                      SelectedIndex="0"
                                                      ToolTip="Pivot the adaptive report around an Entitlement or a Campaign anchor">
                                                <ComboBoxItem Content="Entitlement"/>
                                                <ComboBoxItem Content="Campaign"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Theme -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Theme:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="AdaptiveReportsThemeCombo"
                                                      Style="{StaticResource FieldCombo}"
                                                      SelectedIndex="0"
                                                      ToolTip="Visual theme for the generated HTML report (light or dark)">
                                                <ComboBoxItem Content="light"/>
                                                <ComboBoxItem Content="dark"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Days Back -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Days Back:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="AdaptiveReportsDaysBackBox"
                                                     Style="{StaticResource FieldBox}"
                                                     Text="90"
                                                     ToolTip="Look-back window in days for campaign data (default 90). Increase this if no campaigns are found."/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Status filter + Campaign name filter -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status checkboxes -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Include Status:" Style="{StaticResource FieldLabel}"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <CheckBox x:Name="ChkArStatusCompleted" Content="Completed"
                                                          Foreground="#E0E0E0" IsChecked="True"
                                                          Margin="0,0,12,0" FontSize="12"
                                                          ToolTip="Include COMPLETED campaigns in the report window"/>
                                                <CheckBox x:Name="ChkArStatusActive" Content="Active"
                                                          Foreground="#E0E0E0" IsChecked="True"
                                                          Margin="0,0,12,0" FontSize="12"
                                                          ToolTip="Include ACTIVE campaigns in the report window"/>
                                                <CheckBox x:Name="ChkArStatusStaged" Content="Staged"
                                                          Foreground="#E0E0E0" IsChecked="False"
                                                          Margin="0,0,12,0" FontSize="12"
                                                          ToolTip="Include STAGED campaigns in the report window"/>
                                                <CheckBox x:Name="ChkArStatusCompleting" Content="Completing"
                                                          Foreground="#E0E0E0" IsChecked="False"
                                                          FontSize="12"
                                                          ToolTip="Include COMPLETING campaigns in the report window"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Campaign name filter (optional) -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Campaign Name Contains (optional):" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtArCampaignNameContains"
                                                     Style="{StaticResource FieldBox}"
                                                     ToolTip="Optional: filter to campaigns whose name contains this text. Leave blank to include all campaigns in the window."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Composable Components -->
                            <TextBlock Text="Components" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkArCompKpiCards" Content="KPI Cards"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="True" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the KPI summary-cards component (kpi-cards)"/>
                                    <CheckBox x:Name="ChkArCompHeatmap" Content="Heatmap"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the source x risk heatmap component (heatmap)"/>
                                    <CheckBox x:Name="ChkArCompTree" Content="Tree"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the hierarchical tree component (tree)"/>
                                    <CheckBox x:Name="ChkArCompTopN" Content="Top-N"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="True" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the Top-N ranked-items component (top-n)"/>
                                    <CheckBox x:Name="ChkArCompGroupTable" Content="Group Table"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="True" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the grouped detail-table component (group-table)"/>
                                </WrapPanel>
                            </Border>

                            <!-- Baseline Reports -->
                            <TextBlock Text="Baseline Reports" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkArBaseInventory" Content="Inventory"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the access inventory baseline report (inventory)"/>
                                    <CheckBox x:Name="ChkArBasePrivileged" Content="Privileged"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the privileged-access baseline report (privileged)"/>
                                    <CheckBox x:Name="ChkArBaseOrphaned" Content="Orphaned"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the orphaned-account baseline report (orphaned)"/>
                                    <CheckBox x:Name="ChkArBaseExecSummary" Content="Exec Summary"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the executive-summary baseline report (exec-summary)"/>
                                    <CheckBox x:Name="ChkArBaseRoster" Content="Roster"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the access roster baseline report (roster)"/>
                                    <CheckBox x:Name="ChkArBaseAccessCert" Content="Access Cert"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the access-certification baseline report (access-cert)"/>
                                    <CheckBox x:Name="ChkArBaseSod" Content="SoD"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the Separation-of-Duties baseline report (sod)"/>
                                </WrapPanel>
                            </Border>

                            <!-- Enriched Reports -->
                            <TextBlock Text="Enriched Reports" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkArEnrichedPrivilegedAttestation" Content="Privileged Attestation"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the privileged-attestation audit report from the enriched campaign dataset (privileged-attestation)"/>
                                    <CheckBox x:Name="ChkArEnrichedAccountability" Content="Reviewer Accountability"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the reviewer-accountability audit report from the enriched campaign dataset (accountability)"/>
                                    <CheckBox x:Name="ChkArEnrichedTrend" Content="Campaign Trend"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the period-over-period campaign-trend report from Measure-SPCampaignTrends (trend)"/>
                                    <CheckBox x:Name="ChkArEnrichedDisconnected" Content="Disconnected Apps"
                                              Foreground="#E0E0E0" VerticalAlignment="Center"
                                              IsChecked="False" Margin="0,0,16,4" FontSize="12"
                                              ToolTip="Include the disconnected-app delta/onboarding report from the disconnected-app dataset (disconnected)"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Actions + progress + status -->
                    <StackPanel Grid.Row="2" Margin="8,8,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnArGenerate" Content="Generate"
                                    Style="{StaticResource ToolkitButton}" Margin="0,0,8,0"
                                    ToolTip="Generate the adaptive report(s) from the selected anchor, components and baselines"/>
                            <Button x:Name="BtnArOpenFolder" Content="Open Folder"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Open the output folder containing the generated reports"/>
                            <Button x:Name="BtnArOpenReport" Content="Open Report"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    ToolTip="Open the most recently generated adaptive report in the browser"/>
                        </StackPanel>

                        <ProgressBar x:Name="AdaptiveReportsProgressBar"
                                     Height="10" Background="#252538"
                                     Foreground="#5B9BD5"
                                     BorderBrush="#3D3D5C" BorderThickness="1"
                                     IsIndeterminate="False" Margin="0,0,0,6"/>

                        <TextBlock x:Name="AdaptiveReportsStatusLabel"
                                   Foreground="#AAAACC" FontSize="12" FontStyle="Italic"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings" Style="{StaticResource ToolkitTabItem}">
                <Grid x:Name="SettingsTabContent" Background="#1E1E2E" Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Settings form (inlined; previous ContentControl injection was never wired up) -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,4">

                            <!-- Environment -->
                            <TextBlock Text="Environment" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Environment Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtEnvironmentName" Style="{StaticResource FieldBox}"
                                               ToolTip="Logical label for this environment (e.g. Sandbox, Production)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Debug Mode" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox  Grid.Row="2" Grid.Column="1" x:Name="ChkDebugMode"
                                               Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"
                                               ToolTip="Enable verbose debug logging"/>
                                </Grid>
                            </Border>

                            <!-- Authentication -->
                            <TextBlock Text="Authentication" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Authentication Mode" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CboAuthMode" Style="{StaticResource FieldCombo}"
                                               ToolTip="ConfigFile stores credentials in settings.json. Vault uses encrypted vault file.">
                                        <ComboBoxItem Content="ConfigFile"/>
                                        <ComboBoxItem Content="Vault"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tenant URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtTenantUrl" Style="{StaticResource FieldBox}"
                                               ToolTip="https://&lt;tenant&gt;.api.identitynow.com"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Client ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtClientId" Style="{StaticResource FieldBox}"
                                               ToolTip="OAuth 2.0 client_credentials ClientId (used when Mode=ConfigFile)"/>

                                    <TextBlock   Grid.Row="6" Grid.Column="0" Text="Client Secret" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="PbClientSecret" Style="{StaticResource FieldPassword}"
                                                 ToolTip="Client Secret (only visible in ConfigFile mode; prefer Vault for production)"/>

                                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                            Background="#252538" CornerRadius="4" Padding="10,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF9900">
                                            For production environments, use Authentication Mode = Vault and run New-SPVault.ps1 to store credentials securely. The Client Secret field above is only for ConfigFile mode.
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- API -->
                            <TextBlock Text="API Configuration" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="API Base URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtApiBaseUrl" Style="{StaticResource FieldBox}"
                                               ToolTip="https://&lt;tenant&gt;.api.identitynow.com/v3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Timeout (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtApiTimeout" Style="{StaticResource FieldBox}" Text="60"
                                               ToolTip="HTTP request timeout in seconds"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Retry Count" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtRetryCount" Style="{StaticResource FieldBox}" Text="3"
                                               ToolTip="Number of retries on 429/5xx responses"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rate Limit (req/window)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtRateLimit" Style="{StaticResource FieldBox}" Text="95"
                                               ToolTip="Max requests per window (ISC limit: 95/10s)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Rate Window (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="TxtRateWindow" Style="{StaticResource FieldBox}" Text="10"
                                               ToolTip="Rate limit window in seconds"/>

                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Retry Delay (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="4" x:Name="TxtRetryDelay" Style="{StaticResource FieldBox}" Text="5"
                                               ToolTip="Seconds to wait between retries on server errors"/>
                                </Grid>
                            </Border>

                            <!-- Testing / Paths -->
                            <TextBlock Text="Testing" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Identities CSV Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtIdentitiesCsvPath" Style="{StaticResource FieldBox}"
                                               ToolTip="Path to test-identities.csv (relative to toolkit root or absolute)"/>
                                    <Button    Grid.Row="0" Grid.Column="2" x:Name="BtnBrowseIdentities" Content="Browse"
                                               Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Campaigns CSV Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCampaignsCsvPath" Style="{StaticResource FieldBox}"
                                               ToolTip="Path to test-campaigns.csv (relative to toolkit root or absolute)"/>
                                    <Button    Grid.Row="2" Grid.Column="2" x:Name="BtnBrowseCampaigns" Content="Browse"
                                               Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Evidence Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtEvidencePath" Style="{StaticResource FieldBox}"
                                               ToolTip="Directory where JSONL evidence files are written"/>
                                    <Button    Grid.Row="4" Grid.Column="2" x:Name="BtnBrowseEvidence" Content="Browse"
                                               Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Reports Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtReportsPath" Style="{StaticResource FieldBox}"
                                               ToolTip="Directory where HTML reports are written"/>
                                    <Button    Grid.Row="6" Grid.Column="2" x:Name="BtnBrowseReports" Content="Browse"
                                               Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Safety -->
                            <TextBlock Text="Safety Controls" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max Campaigns Per Run" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtMaxCampaignsPerRun" Style="{StaticResource FieldBox}"
                                               Text="10" Width="80" HorizontalAlignment="Left"
                                               ToolTip="Hard limit on campaigns per execution (prevents runaway test runs)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Require WhatIf on Prod" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox  Grid.Row="2" Grid.Column="1" x:Name="ChkRequireWhatIf"
                                               IsChecked="True" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"
                                               ToolTip="Forces confirmation before running against an environment with RequireWhatIfOnProd=true"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Allow Complete Campaign" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox  Grid.Row="4" Grid.Column="1" x:Name="ChkAllowComplete"
                                               IsChecked="False" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"
                                               ToolTip="Allow tests to call POST /campaigns/{id}/complete (only works on past-due campaigns)"/>

                                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                            Background="#252538" CornerRadius="4" Padding="10,6">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF9900">
                                            Safety controls are enforced at runtime by Invoke-GovernanceTest.ps1. AllowCompleteCampaign should remain false unless you are explicitly testing campaign completion on a past-due campaign in a non-production environment.
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Delta Cert -->
                            <TextBlock Text="Delta Cert" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source IDs" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtDcSourceIds" Style="{StaticResource FieldBox}"
                                               ToolTip="Comma-separated list of AD source IDs to monitor for GRANT_ACCESS events"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Hours Back" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtDcHoursBack" Style="{StaticResource FieldBox}"
                                               Text="24" Width="80" HorizontalAlignment="Left"
                                               ToolTip="How many hours back to search for GRANT_ACCESS events"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Default Deadline Days" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtDcDeadlineDays" Style="{StaticResource FieldBox}"
                                               Text="2" Width="80" HorizontalAlignment="Left"
                                               ToolTip="Certification campaign deadline in days from creation"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Default Reviewer Mode" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox  Grid.Row="6" Grid.Column="1" x:Name="CboDcReviewerMode" Style="{StaticResource FieldCombo}"
                                               Width="160" HorizontalAlignment="Left"
                                               ToolTip="Who reviews the certification: identity manager or source owner">
                                        <ComboBoxItem Content="Manager" IsSelected="True"/>
                                        <ComboBoxItem Content="SourceOwner"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Campaign Name Prefix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TxtDcCampaignPrefix" Style="{StaticResource FieldBox}"
                                               Text="AD Delta Cert"
                                               ToolTip="Prefix for auto-generated certification campaign names"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Output Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TxtDcOutputPath" Style="{StaticResource FieldBox}"
                                               Text=".\DeltaCert"
                                               ToolTip="Directory where DeltaCert output files are written"/>
                                </Grid>
                            </Border>

                            <!-- Governance -->
                            <TextBlock Text="Governance" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource SectionBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Metrics Output Path" Style="{StaticResource FieldLabel}"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtGovMetricsPath" Style="{StaticResource FieldBox}"
                                               Text=".\GovernanceMetrics"
                                               ToolTip="Directory where governance health check and metric files are written"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Health Check on Startup" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox  Grid.Row="2" Grid.Column="1" x:Name="ChkGovHealthCheckOnStartup"
                                               IsChecked="False" Foreground="#E0E0E0" FontSize="12" VerticalAlignment="Center"
                                               ToolTip="Automatically run a governance health check when the dashboard opens"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Quick Connect: Browser Token -->
                    <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                            BorderBrush="#3D3D5C" BorderThickness="1"
                            Padding="16,12" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Quick Connect - Browser Token"
                                       Foreground="#5B9BD5" FontWeight="SemiBold" FontSize="13"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox Grid.Column="0" x:Name="PbBrowserToken"
                                             Background="#252538" Foreground="#E0E0E0"
                                             BorderBrush="#3D3D5C" BorderThickness="1"
                                             Padding="8,4" FontSize="12" Height="30"
                                             PasswordChar="*"
                                             ToolTip="Paste JWT from browser dev tools (F12 > Network tab > copy Authorization header value)"/>

                                <Button Grid.Column="2" x:Name="BtnApplyToken"
                                        Content="Apply Token"
                                        Style="{StaticResource ToolkitButton}"/>

                                <Button Grid.Column="4" x:Name="BtnClearToken"
                                        Content="Clear Token"
                                        Style="{StaticResource SecondaryButton}"/>
                            </Grid>

                            <TextBlock Grid.Row="4" x:Name="BrowserTokenStatus"
                                       Foreground="#888899" FontSize="11" TextWrapping="Wrap"
                                       Text="No browser token active. Paste a JWT from the ISC admin console to bypass OAuth credentials."/>
                        </Grid>
                    </Border>

                    <!-- Bottom button bar -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnSaveSettings"
                                Content="Save Settings" Style="{StaticResource ToolkitButton}"
                                Margin="0,0,8,0"/>
                        <Button Grid.Column="1" x:Name="BtnResetDefaults"
                                Content="Reset to Defaults" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>

                        <Button Grid.Column="3" x:Name="BtnTestConnectivity"
                                Content="Test Connectivity" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="4" x:Name="ConnectivityStatusText"
                                   Foreground="#AAAACC" VerticalAlignment="Center"
                                   MaxWidth="300" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252538" BorderBrush="#3D3D5C" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusBarText"
                       Foreground="#AAAACC"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       Text="Ready"/>
        </Border>

    </Grid>
</Window>
