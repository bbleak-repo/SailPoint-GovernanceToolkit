<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Campaign Template"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6DACE0"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Background" Value="#4A85BB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3D3D5C"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#1E1E2E">
        <StackPanel>
            <TextBlock Text="Template Name:" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtTemplateName" Style="{StaticResource FieldBox}" Width="400"
                     HorizontalAlignment="Left" Margin="0,0,0,12"
                     ToolTip="Unique name for the new campaign template."/>

            <TextBlock Text="Deadline Duration (ISO 8601, e.g. P14D):" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtDeadlineDuration" Style="{StaticResource FieldBox}" Width="200"
                     HorizontalAlignment="Left" Text="P14D" Margin="0,0,0,12"
                     ToolTip="Duration until campaign deadline in ISO 8601 format (e.g. P14D = 14 days, P1M = 1 month)."/>

            <TextBlock Text="Owner Identity ID:" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtTemplateOwnerId" Style="{StaticResource FieldBox}" Width="300"
                     HorizontalAlignment="Left" Margin="0,0,0,12"
                     ToolTip="Identity ID of the campaign template owner."/>

            <TextBlock Text="Reviewer Type:" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CboReviewerType" Width="180" HorizontalAlignment="Left"
                      Background="#2D2D44" Foreground="#E0E0E0" BorderBrush="#3D3D5C"
                      SelectedIndex="0" Margin="0,0,0,20"
                      ToolTip="Who reviews the generated campaign items.">
                <ComboBoxItem Content="MANAGER"/>
                <ComboBoxItem Content="SELF"/>
                <ComboBoxItem Content="NONE"/>
            </ComboBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="BtnOK"     Content="Create"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"
                        ToolTip="Create the campaign template."/>
                <Button Grid.Column="3" x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"
                        ToolTip="Close without creating."/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
