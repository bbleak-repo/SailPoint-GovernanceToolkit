<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Governance Tab Design Reference"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">
    <!--
        DESIGN REFERENCE ONLY - not loaded at runtime.
        The actual tab content is inlined in MainWindow.xaml as GovernanceTabContent.
        This file mirrors the production layout for visual inspection and iteration.
    -->

    <Grid x:Name="GovernanceTabContent" Background="#1E1E2E" Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Health Check Status Badges -->
        <Border Grid.Row="0" Background="#2D2D44" CornerRadius="6"
                BorderBrush="#3D3D5C" BorderThickness="1"
                Padding="12,10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <Border x:Name="GovBadgeSourceHealth" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" Margin="0,0,8,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Source Health" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GovBadgeDataQuality" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" Margin="0,0,8,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Data Quality" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GovBadgePolicy" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" Margin="0,0,8,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Policy" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GovBadgeConfigDrift" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" Margin="0,0,8,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Config Drift" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GovBadgeOrphans" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" Margin="0,0,8,0" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Orphans" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="GovBadgeCoverage" Background="#252538"
                        BorderBrush="#666677" BorderThickness="1" CornerRadius="4"
                        Padding="10,6" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="Coverage" Foreground="#AAAACC" FontSize="10"
                                   TextAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="?" Foreground="#888899" FontSize="13" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Row 1: Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="GovMetricMaturity"
                    Background="#2D2D44" CornerRadius="6"
                    BorderBrush="#3D3D5C" BorderThickness="1"
                    Padding="16,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="--/5" Foreground="#5B9BD5" FontSize="28" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Maturity Score" Foreground="#AAAACC" FontSize="11"
                               TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" x:Name="GovMetricPolicyPct"
                    Background="#2D2D44" CornerRadius="6"
                    BorderBrush="#3D3D5C" BorderThickness="1"
                    Padding="16,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="--%" Foreground="#5B9BD5" FontSize="28" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Policy Compliance" Foreground="#AAAACC" FontSize="11"
                               TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" x:Name="GovMetricCoveragePct"
                    Background="#2D2D44" CornerRadius="6"
                    BorderBrush="#3D3D5C" BorderThickness="1"
                    Padding="16,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="--%" Foreground="#5B9BD5" FontSize="28" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Coverage Rate" Foreground="#AAAACC" FontSize="11"
                               TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Action Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnRunHealthCheck"
                    Content="Run Health Check"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1" x:Name="BtnGenerateGovReport"
                    Content="Generate Governance Report"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="2" x:Name="BtnExportDashboardData"
                    Content="Export Dashboard Data"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="3" x:Name="BtnOpenGovFolder"
                    Content="Open Reports Folder"/>
        </Grid>

        <!-- Row 3: Progress bar + status label -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="GovStatusLabel"
                       Foreground="#AAAACC" VerticalAlignment="Center"
                       FontSize="12" Margin="0,0,12,0"/>

            <ProgressBar Grid.Column="1" x:Name="GovProgressBar"
                         Height="10" Background="#252538"
                         Foreground="#5B9BD5"
                         BorderBrush="#3D3D5C" BorderThickness="1"
                         Visibility="Collapsed"/>

            <TextBlock Grid.Column="2" x:Name="GovProgressPercent"
                       Foreground="#AAAACC" VerticalAlignment="Center"
                       FontSize="12" Margin="8,0,0,0"/>
        </Grid>

        <!-- Row 4: Recent Governance Reports -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Recent Governance Reports"
                           Foreground="#5B9BD5" FontWeight="SemiBold"
                           VerticalAlignment="Center" FontSize="12"/>
                <Button Grid.Column="1" x:Name="BtnRefreshGovReports"
                        Content="Refresh"
                        Padding="10,4" FontSize="11"/>
            </Grid>

            <Border Grid.Row="1" Background="#2D2D44" CornerRadius="6"
                    BorderBrush="#3D3D5C" BorderThickness="1">
                <ListBox x:Name="GovReportList"
                         MaxHeight="150"
                         Background="#2D2D44"
                         Foreground="#E0E0E0"
                         BorderThickness="0"
                         Margin="4"
                         FontSize="12"/>
            </Border>
        </Grid>

    </Grid>
</Window>
