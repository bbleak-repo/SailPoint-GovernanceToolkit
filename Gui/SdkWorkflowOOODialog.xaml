<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create OOO Fallback Workflow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="480"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6666AA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6DACE0"/></Trigger>
                            <Trigger Property="IsPressed"   Value="True"><Setter Property="Background" Value="#4A85BB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3D3D5C"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#1E1E2E">
        <StackPanel>
            <TextBlock Text="Primary Reviewer — Identity ID:" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtOOOPrimaryReviewerId" Style="{StaticResource FieldBox}" Width="380"
                     HorizontalAlignment="Left" Margin="0,0,0,2"
                     ToolTip="Identity ID of the reviewer who may be out of office."/>
            <TextBlock Text="The reviewer whose absence triggers the fallback." Style="{StaticResource HintText}"/>

            <TextBlock Text="Fallback Reviewer — Identity ID:" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtOOOFallbackReviewerId" Style="{StaticResource FieldBox}" Width="380"
                     HorizontalAlignment="Left" Margin="0,0,0,2"
                     ToolTip="Identity ID of the reviewer who will handle items when the primary is out."/>
            <TextBlock Text="Who receives work items when the primary is unavailable." Style="{StaticResource HintText}"/>

            <TextBlock Text="Fallback After (days):" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtOOOFallbackDays" Style="{StaticResource FieldBox}" Width="100"
                     HorizontalAlignment="Left" Text="3" Margin="0,0,0,20"
                     ToolTip="Number of days with no action before the fallback reviewer takes over."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="BtnOK"     Content="Create OOO Workflow"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"
                        ToolTip="Create the out-of-office fallback reviewer workflow."/>
                <Button Grid.Column="3" x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"
                        ToolTip="Close without creating."/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
