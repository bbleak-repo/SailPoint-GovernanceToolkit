<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Template Schedule"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="450"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6DACE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A85BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="20" Background="#1E1E2E">
        <StackPanel>
            <!-- Schedule Type -->
            <TextBlock Text="Schedule Type:" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CboScheduleType" Width="200" HorizontalAlignment="Left"
                      Background="#2D2D44" Foreground="#E0E0E0"
                      BorderBrush="#3D3D5C" BorderThickness="1"
                      FontSize="12" Margin="0,0,0,12"
                      ToolTip="Cadence the campaign template runs on."
                      SelectedIndex="0">
                <ComboBoxItem Content="MONTHLY" IsSelected="True"/>
                <ComboBoxItem Content="WEEKLY"/>
                <ComboBoxItem Content="ANNUALLY"/>
                <ComboBoxItem Content="CALENDAR"/>
            </ComboBox>

            <!-- Hours + Days side by side -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hours (e.g. 9):" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtScheduleHours" Style="{StaticResource FieldBox}" Width="80"
                             HorizontalAlignment="Left" Text="9"
                             ToolTip="Hour of day (0-23) the run starts."/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Days (comma-separated, e.g. 1,15):" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtScheduleDays" Style="{StaticResource FieldBox}"
                             ToolTip="Days the run fires; meaning depends on schedule type."/>
                </StackPanel>
            </Grid>

            <!-- Time Zone -->
            <TextBlock Text="Time Zone:" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CboScheduleTimeZone" Width="200" HorizontalAlignment="Left"
                      Background="#2D2D44" Foreground="#E0E0E0"
                      BorderBrush="#3D3D5C" BorderThickness="1"
                      FontSize="12" Margin="0,0,0,12"
                      ToolTip="IANA time zone id used to interpret the schedule."
                      SelectedIndex="0">
                <ComboBoxItem Content="America/New_York" IsSelected="True"/>
                <ComboBoxItem Content="America/Chicago"/>
                <ComboBoxItem Content="America/Denver"/>
                <ComboBoxItem Content="America/Los_Angeles"/>
                <ComboBoxItem Content="UTC"/>
                <ComboBoxItem Content="Europe/London"/>
                <ComboBoxItem Content="Europe/Paris"/>
            </ComboBox>

            <!-- Expiration -->
            <TextBlock Text="Expiration (YYYY-MM-DD, optional):" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtScheduleExpiration" Style="{StaticResource FieldBox}" Width="160"
                     HorizontalAlignment="Left" Text="" Margin="0,0,0,20"
                     ToolTip="Optional end date for the schedule (YYYY-MM-DD)."/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="BtnOK" Content="Save Schedule"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"
                        ToolTip="Save the schedule for this campaign template."/>
                <Button Grid.Column="3" x:Name="BtnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"
                        ToolTip="Close without changing the schedule."/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
